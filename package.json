    "vite": "^8.3.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.57.0",
    "recharts": "^3.10.1"
  }
