# FreshRoute — Environment Configuration Template
# Server-side secrets must NEVER be prefixed with VITE_ or exposed to client bundles.

# Port for backend Express server
PORT=3001

# Google Maps JavaScript API Key (Client-side, domain-restricted in production)
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps / Routes API Key (Server-side, for computeRoutes calls)
GOOGLE_MAPS_API_KEY=

# OpenRouter API Key for Qwen Assistant
OPENROUTER_API_KEY=

# OpenRouter Model Identifier (default: qwen/qwen-2.5-72b-instruct)
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
